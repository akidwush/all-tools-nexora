{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self)"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/database",
      "destination": "/api/health?mode=database"
    },
    {
      "source": "/api/analytics",
      "destination": "/api/feedback?mode=analytics"
    },
    {
      "source": "/api/media-download",
      "destination": "/api/tool-health?mode=media-download"
    },
    {
      "source": "/api/sitegrabber",
      "destination": "/api/tool-health?mode=sitegrabber"
    },
    {
      "source": "/api/crypto-market",
      "destination": "/api/tool-health?mode=crypto-market"
    },
    {
      "source": "/api/web-intelligence",
      "destination": "/api/audit?mode=web-intelligence"
    },
    {
      "source": "/api/vdeploy",
      "destination": "/api/health?mode=vdeploy"
    }
  ]
}

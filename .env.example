# Supabase project
SUPABASE_URL=https://PROJECT_ID.supabase.co

# Gunakan salah satu elevated key berikut. SUPABASE_SECRET_KEY lebih disarankan.
# Jangan pernah menaruh key ini di browser atau source code publik.
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
# SUPABASE_SERVICE_ROLE_KEY=legacy_service_role_jwt

# Opsional untuk Auth. Jika kosong, backend memakai elevated key secara server-side.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# SUPABASE_ANON_KEY=legacy_anon_jwt

DATABASE_TIMEOUT_MS=8000
FEEDBACK_HASH_SALT=replace_with_a_long_random_string

# Live audit
AUDIT_TIMEOUT_MS=4000
AUDIT_MAX_ITEMS=16
AUDIT_CONCURRENCY=6

# Tool health monitoring
HEALTH_CHECK_TOKEN=replace_with_a_long_random_token
HEALTH_CHECK_TIMEOUT_MS=4500
HEALTH_CHECK_CONCURRENCY=6
HEALTH_STALE_MS=900000
HEALTH_DEGRADED_LATENCY_MS=2500

# Crypto Market Scanner — server-side only. Jangan gunakan NEXT_PUBLIC_.
# Tanpa key, endpoint otomatis memakai CoinPaprika sebagai fallback.
COINGECKO_API_KEY=
CRYPTO_MARKET_TIMEOUT_MS=9000
CRYPTO_MARKET_CACHE_MS=60000

# v5.1 analytics memakai FEEDBACK_HASH_SALT untuk hashing pengunjung anonim.
# Tidak ada environment variable wajib baru untuk v5.1.

# SiteGrabber-X API v1 — server-side only. Jangan gunakan NEXT_PUBLIC_.
SITEGRABBER_API_BASE_URL=https://sitegrabber-x-production.up.railway.app
SITEGRABBER_API_KEY=sgx_live_your_server_only_key

# Nexus Deploy Center — server-side only
# Buat access key acak untuk melindungi endpoint deploy dari pengunjung publik.
NEXUS_DEPLOY_ACCESS_KEY=replace_with_a_long_random_deploy_key
# Token Vercel diperlukan jika platform Vercel ingin dipakai.
VERCEL_TOKEN=
# Opsional jika project berada di team Vercel.
VERCEL_TEAM_ID=
# Token Netlify diperlukan hanya jika platform Netlify ingin dipakai.
NETLIFY_TOKEN=

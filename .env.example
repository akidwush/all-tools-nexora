# Isi hanya di Environment Variables Vercel. Jangan taruh service role key di browser.
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Batas waktu koneksi Supabase dalam milidetik.
DATABASE_TIMEOUT_MS=8000

# String acak panjang untuk mengubah alamat IP menjadi hash anonim.
FEEDBACK_HASH_SALT=replace_with_a_long_random_string

# Optional live audit tuning
AUDIT_TIMEOUT_MS=4000
AUDIT_MAX_ITEMS=16
AUDIT_CONCURRENCY=6

# Tool health monitoring
# Token acak untuk pemeriksaan paksa melalui POST /api/tool-health.
HEALTH_CHECK_TOKEN=replace_with_a_long_random_token
HEALTH_CHECK_TIMEOUT_MS=4500
HEALTH_CHECK_CONCURRENCY=6
HEALTH_STALE_MS=900000
HEALTH_DEGRADED_LATENCY_MS=2500

# Supabase project
SUPABASE_URL=https://PROJECT_ID.supabase.co

# Gunakan salah satu elevated key berikut. SUPABASE_SECRET_KEY lebih disarankan.
# Jangan pernah menaruh key ini di browser atau source code publik.
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
# SUPABASE_SERVICE_ROLE_KEY=legacy_service_role_jwt

# Opsional untuk Auth. Jika kosong, backend memakai elevated key secara server-side.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# SUPABASE_ANON_KEY=legacy_anon_jwt

DATABASE_TIMEOUT_MS=8000
FEEDBACK_HASH_SALT=replace_with_a_long_random_string

# Live audit
AUDIT_TIMEOUT_MS=4000
AUDIT_MAX_ITEMS=16
AUDIT_CONCURRENCY=6

# Tool health monitoring
HEALTH_CHECK_TOKEN=replace_with_a_long_random_token
HEALTH_CHECK_TIMEOUT_MS=4500
HEALTH_CHECK_CONCURRENCY=6
HEALTH_STALE_MS=900000
HEALTH_DEGRADED_LATENCY_MS=2500

# Downloader fallback opsional. Gunakan HTTPS dan placeholder {url}; pisahkan fallback dengan koma.
# Contoh: https://provider.example/api?url={url}&password={password}
DOWNLOADER_INSTAGRAM_PRIMARY_URL=
DOWNLOADER_INSTAGRAM_FALLBACK_URLS=
DOWNLOADER_TERABOX_PRIMARY_URL=
DOWNLOADER_TERABOX_FALLBACK_URLS=
DOWNLOADER_SPOTIFY_PRIMARY_URL=
DOWNLOADER_SPOTIFY_FALLBACK_URLS=

# Crypto Market Scanner — server-side only. Jangan gunakan NEXT_PUBLIC_.
# Tanpa key, endpoint otomatis memakai CoinPaprika sebagai fallback.
COINGECKO_API_KEY=
CRYPTO_MARKET_TIMEOUT_MS=9000
CRYPTO_MARKET_CACHE_MS=60000

# Nexora Web Intelligence — semua key hanya dibaca server-side.
WEB_INTEL_TIMEOUT_MS=12000
WEB_INTEL_CACHE_MS=300000
# Opsional, tetapi disarankan untuk Deep Intelligence yang sering dipakai.
GOOGLE_PAGESPEED_API_KEY=
# Opsional: aktifkan Safe Browsing API di Google Cloud untuk reputasi ancaman.
GOOGLE_SAFE_BROWSING_API_KEY=

# IP & ASN Intelligence — IPinfo Lite, server-side only.
# Ambil token gratis dari dashboard IPinfo, lalu simpan sebagai IPINFO_TOKEN di Vercel.
IPINFO_TOKEN=
IPINFO_TIMEOUT_MS=8000
IPINFO_CACHE_MS=600000

# NASA Space Explorer — server-side only. Jangan gunakan NEXT_PUBLIC_.
# Jika kosong, tool tetap berjalan memakai DEMO_KEY dengan kuota rendah.
NASA_API_KEY=
NASA_API_TIMEOUT_MS=10000
NASA_API_CACHE_MS=900000

# Nexora OCR Intelligence — server-side only. Daftar key gratis: https://ocr.space/ocrapi
# Free API: file maksimal 1 MB dan PDF maksimal 3 halaman.
OCR_SPACE_API_KEY=
OCR_SPACE_TIMEOUT_MS=45000
# Opsional untuk endpoint PRO. Default memakai https://api.ocr.space/parse/image
# OCR_SPACE_API_ENDPOINT=

# v5.1 analytics memakai FEEDBACK_HASH_SALT untuk hashing pengunjung anonim.
# Tidak ada environment variable wajib baru untuk v5.1.

# SiteGrabber-X API v1 — server-side only. Jangan gunakan NEXT_PUBLIC_.
SITEGRABBER_API_BASE_URL=https://sitegrabber-x-production.up.railway.app
SITEGRABBER_API_KEY=sgx_live_your_server_only_key

# Nexus Deploy Center — server-side only
# Buat access key acak untuk melindungi endpoint deploy dari pengunjung publik.
NEXUS_DEPLOY_ACCESS_KEY=replace_with_a_long_random_deploy_key
# Token Vercel diperlukan jika platform Vercel ingin dipakai.
VERCEL_TOKEN=
# Opsional jika project berada di team Vercel.
VERCEL_TEAM_ID=
# Token Netlify diperlukan hanya jika platform Netlify ingin dipakai.
NETLIFY_TOKEN=

# FreeConvert PNG/JPG -> SVG
FREECONVERT_API_KEY=
FREECONVERT_TIMEOUT_MS=20000

# SVG -> Alight Motion XML API
# Nama resmi key untuk integrasi Nexora. Alias lama SVGTOXML_API_KEY tetap didukung.
SVGTOXML_ENGINE_KEY=
SVGTOXML_API_BASE_URL=https://svgtoxml.vercel.app
SVGTOXML_TIMEOUT_MS=30000
# Simpan key hanya sebagai environment server/Vercel; jangan masukkan ke JavaScript browser.

# Alight Motion Premium provider API — dua endpoint GET, tanpa key/token tambahan.
ALIGHT_PREMIUM_API_BASE_URL=https://api.kyzznekoo.my.id
ALIGHT_PREMIUM_MAGIC_LINK_PATH=/api/alightmotion/v1/magic-link
ALIGHT_PREMIUM_APPLY_PATH=/api/alightmotion/v1/applyPremium

# Gemini API — server-side only
GEMINI_API_KEY=
GEMINI_MODEL=
